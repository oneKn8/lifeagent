FROM oven/bun:1.3 AS base
WORKDIR /app

FROM base AS deps
COPY package.json bun.lock ./
COPY apps/agent/package.json apps/agent/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/types/package.json packages/types/package.json
RUN bun install --frozen-lockfile

FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY package.json bun.lock biome.json bunfig.toml tsconfig.json ./
COPY apps/agent ./apps/agent
COPY packages ./packages
RUN bun build apps/agent/src/index.ts \
  --target=bun \
  --outdir=apps/agent/dist

FROM base AS runtime
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/apps/agent/dist ./apps/agent/dist
COPY apps/agent/src/skills ./apps/agent/src/skills
COPY packages ./packages
COPY package.json ./

CMD ["bun", "apps/agent/dist/index.js"]
