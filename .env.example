DATABASE_URL=postgres://lifeagent:lifeagent@localhost:5544/lifeagent
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=

# Brain provider — default openrouter (free tier). Override to "anthropic" or "ollama".
BRAIN_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Optional: comma-separated override of free-model rotation chain
OPENROUTER_MODEL_CHAIN=

# Optional alternative brains (only used if BRAIN_PROVIDER set to one of these)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Verifiers
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
GITHUB_PAT=
WAKATIME_API_KEY=

# Calendar source (Phase 12)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encryption for stored OAuth refresh tokens
ENCRYPTION_KEY=
